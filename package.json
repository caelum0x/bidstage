{
  "name": "bidstage",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "migrate": "node --import tsx scripts/migrate.ts",
    "operator": "node --import tsx scripts/operator.ts",
    "audit:release": "node --import tsx scripts/release-audit.ts",
    "preview:worker": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "build:worker": "opennextjs-cloudflare build",
    "create:hyperdrive": "zsh scripts/create-hyperdrive.zsh",
    "bootstrap:production-db": "zsh scripts/bootstrap-production-database.zsh",
    "preflight:production": "node --import tsx scripts/production-preflight.ts",
    "deploy:worker": "bun run preflight:production && opennextjs-cloudflare build && wrangler deploy --secrets-file .secrets.production",
    "upload:worker": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "deploy:email": "cd email-worker && ../node_modules/.bin/wrangler deploy --keep-vars",
    "types:email": "cd email-worker && ../node_modules/.bin/wrangler types --include-runtime=false --env-interface SupportMailEnv cloudflare-env.d.ts",
    "cf-typegen": "wrangler types --include-runtime=false --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "BIDSTAGE_REQUIRE_INTEGRATION=1 node --import tsx --test test/integration/*.test.ts",
    "smoke:http": "node --import tsx scripts/http-smoke.ts",
    "verify": "bun run typecheck && bun run test && bun run test:integration && bun run build:worker && wrangler deploy --dry-run"
  },
  "dependencies": {
    "next": "16.3.0",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "wrangler": "^4.86.0"
  }
}
