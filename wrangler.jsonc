{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bidstage",
	"account_id": "c7a5b49549dcb64f2e258db485c723ca",
	"main": "custom-worker.ts",
	"compatibility_date": "2026-08-23",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"ratelimits": [
		{
			"name": "EDGE_WRITE_RATE_LIMITER",
			"namespace_id": "284712001",
			"simple": {
				"limit": 20,
				"period": 60
			}
		}
	],
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "bidstage"
		}
	],
	"routes": [
		{
			"pattern": "bidstage.app",
			"custom_domain": true
		}
	],
	"placement": {
		"mode": "smart"
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": false
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.05
		}
	},
	"triggers": {
		"crons": ["15 * * * *"]
	},
	"vars": {
		"APP_URL": "https://bidstage.app",
		"PAYMENT_PROVIDER": "creem",
		"CREEM_TEST_MODE": "false",
		"CHECKOUT_ENABLED": "false",
		"TURNSTILE_SITE_KEY": "0x4AAAAAAEZg5FPIO9JvkcXu"
	},
	"secrets": {
		"required": [
			"FOUNDER_ACCESS_SECRET",
			"GITHUB_CLIENT_ID",
			"GITHUB_CLIENT_SECRET",
			"GOOGLE_CLIENT_ID",
			"GOOGLE_CLIENT_SECRET",
			"RATE_LIMIT_SALT",
			"MAINTENANCE_SECRET"
		]
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "af2067dc7e2543c79a66ff16513bf980"
		}
	]
}
